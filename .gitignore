# Dependencies
node_modules

# Environment files — never commit a real one.
# `.env.example` is the documented template and is deliberately tracked.
*.env
.env
.env.*
!.env.example

# Build output
dist/
build/

# Test and coverage output
coverage/
*.lcov
.vitest-cache/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor and OS noise
.DS_Store
Thumbs.db
.idea/
*.swp

# Local end-to-end runs (frontend/e2e). Everything here is produced by a run and
# describes one machine's ports, traces and screenshots.
frontend/e2e/.e2e-state.json
frontend/test-results/
frontend/playwright-report/

# Local Lighthouse reports (Gate 4). Generated by `npm run lighthouse`;
# the measured figures that matter are quoted in .local-audit/25_PHASE_4_STATUS.md.
frontend/.lighthouse/
