#############################################################################
# Netronix — admin console environment
#
# Copy to `admin/.env` and adjust. `.env` is gitignored; this file is committed
# and must never contain a real credential.
#
# EVERY VARIABLE HERE IS PUBLIC.
#
# Vite inlines any variable prefixed `VITE_` into the JavaScript bundle it
# ships to the browser. Anyone who loads the console can read these values.
#
# In particular: ADMIN_EMAIL and ADMIN_PASSWORD belong in `backend/.env` and
# must never appear here. The console authenticates by POSTing credentials the
# operator types to `/api/user/admin`; it does not hold them.
#
# `admin/src/config.js` validates these at startup and fails with an explicit
# message rather than letting requests go to "undefined/api/...".
#############################################################################

# --- Required ---------------------------------------------------------------

# Absolute base URL of the Netronix API, with no trailing slash.
# Local development: http://localhost:4000
VITE_BACKEND_URL=http://localhost:4000
