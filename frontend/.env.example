#############################################################################
# Netronix — storefront environment
#
# Copy to `frontend/.env` and adjust. `.env` is gitignored; this file is
# committed and must never contain a real credential.
#
# EVERY VARIABLE HERE IS PUBLIC.
#
# Vite inlines any variable prefixed `VITE_` into the JavaScript bundle it
# ships to the browser. Anyone who loads the site can read these values by
# viewing the bundle. Never put an API key, a database URI, a JWT secret, or
# any other server-only value in this file — those belong in `backend/.env`,
# which is never bundled.
#
# `frontend/src/config.js` validates these at startup and fails with an
# explicit message rather than letting requests go to "undefined/api/...".
#############################################################################

# --- Required ---------------------------------------------------------------

# Absolute base URL of the Netronix API, with no trailing slash.
# Local development: http://localhost:4000
VITE_BACKEND_URL=http://localhost:4000

# --- Optional ---------------------------------------------------------------

# Absolute base URL of this storefront, used when the app needs to build a
# fully-qualified link to itself. Falls back to window.location.origin.
VITE_FRONTEND_URL=http://localhost:5173
