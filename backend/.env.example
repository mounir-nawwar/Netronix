#############################################################################
# Netronix — backend environment
#
# Copy to `backend/.env` and fill in real values. `.env` is gitignored; this
# file is committed and must never contain a real credential.
#
# Every variable below is SERVER-ONLY. None of them is ever sent to a browser.
# Client-visible configuration lives in `frontend/.env.example` and
# `admin/.env.example`, where it is prefixed `VITE_`.
#
# `backend/config/env.js` validates these at boot and refuses to start with a
# clear list of what is wrong. It never prints a value.
#############################################################################

# --- Required ---------------------------------------------------------------

# Complete MongoDB connection string, including the database name. The
# application passes this URI to the driver unchanged, so mongodb:// and
# mongodb+srv:// options remain valid. Core writes use transactions: the target
# must be a replica set or mongos, not a standalone mongod.
# Local example: mongodb://127.0.0.1:27017/e-commerce?replicaSet=netronix-rs
MONGODB_URI=mongodb://127.0.0.1:27017/e-commerce?replicaSet=netronix-rs

# Secret used to sign session JWTs. Must be at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# `npm run setup` generates one for you.
#
# A weak, short or known-placeholder value is a HARD BOOT FAILURE in every
# environment, checked before any database connection is attempted (SEC-014).
# Rotating it invalidates every session token that has been issued, which is
# the intended effect.
JWT_SECRET=replace-with-a-generated-secret-at-least-32-chars

# --- No admin credentials live here any more (SEC-001) ----------------------
#
# ADMIN_EMAIL and ADMIN_PASSWORD are gone. The admin login used to compare the
# submitted password against ADMIN_PASSWORD in plain text and then sign a JWT
# over the string `email + password` — so the admin password was recoverable
# from any issued token by anyone holding it, base64url being an encoding and
# not encryption.
#
# The admin is now an ordinary user document with `role: 'admin'` and a bcrypt
# hash. Create one against a local database with:
#
#   npm run create-admin -- --uri=mongodb://127.0.0.1:27017/netronix_dev --email=you@example.test
#
# The script prompts for the password without echoing it, refuses to take one
# on the command line, and refuses any target that is not a local, disposable
# database.

# --- Optional ---------------------------------------------------------------

# development | test | production. Defaults to development.
# Setting production tightens JWT_SECRET validation.
NODE_ENV=development

# HTTP port. Defaults to 4000.
PORT=4000

# Groq key for the support chatbot, free at console.groq.com/keys. Without it
# the chatbot returns a canned "temporarily unavailable" reply and the rest of
# the API is unaffected. Groq exposes an OpenAI-compatible endpoint, which is
# what `services/AIclient.js` calls — same `openai` npm client, a different
# baseURL.
GROQ_API_KEY=gsk_replace-me

# Which Groq-hosted model to call. Optional — defaults to the flagship free-
# tier model `services/AIclient.js` hardcodes. Override if that model is ever
# retired; providers rotate free-tier model names faster than this file
# gets edited. See console.groq.com/docs/models for the current list.
GROQ_MODEL=llama-3.3-70b-versatile

# Cloudinary credentials for product image upload from the admin console.
# Without them the catalog still serves, but adding a product fails.
CLOUDINARY_NAME=replace-me
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_SECRET_KEY=replace-me

# Absolute URL of the storefront. Example: http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Comma-separated list of browser origins allowed to call this API
# (DEVOPS-004). Absent falls back to the four origins that used to be hardcoded
# in app.js. Every entry must be an absolute http:// or https:// origin; `*` is
# refused, because a wildcard allowlist is not an allowlist.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Tooling ----------------------------------------------------------------

# Target for `npm run seed`. Deliberately separate from MONGODB_URI so the seed
# can never inherit the database the application runs against.
#
# The seed refuses anything that is not a local, disposable target: no
# mongodb+srv://, no non-loopback host, no credentials, and the database name
# must contain test, local, dev or demo.
SEED_MONGODB_URI=mongodb://127.0.0.1:27017/netronix_dev
